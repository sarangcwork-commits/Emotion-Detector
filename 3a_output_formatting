"""
Module to interact with Watson NLP Emotion Detection API with formatted output.
"""
import json
import requests

def emotion_detector(text_to_analyze):
    """
    Analyzes text using Watson NLP and returns a formatted dictionary 
    containing all emotion scores and the dominant emotion.
    """
    url = (
        'https://skills.network'
        'v1/watson.runtime.nlp.v1/NlpService/EmotionPredict'
    )
    headers = {"grpc-metadata-mm-model-id": "emotion_aggregated-workflow_lang_en_stock"}
    myobj = {"raw_document": {"text": text_to_analyze}}
    
    response = requests.post(url, json=myobj, headers=headers, timeout=10)
    
    # Parse the response text into a JSON object
    formatted_response = json.loads(response.text)
    
    # Extract the emotion dictionary details
    emotion_predictions = formatted_response['emotionPredictions'][0]['emotion']
    
    anger = emotion_predictions['anger']
    disgust = emotion_predictions['disgust']
    fear = emotion_predictions['fear']
    joy = emotion_predictions['joy']
    sadness = emotion_predictions['sadness']
    
    # Create the internal collection to evaluate the dominant emotion
    emotions_dict = {
        'anger': anger,
        'disgust': disgust,
        'fear': fear,
        'joy': joy,
        'sadness': sadness
    }
    
    # Identify the emotion with the maximum score
    dominant_emotion = max(emotions_dict, key=emotions_dict.get)
    
    # Construct the final expected output format
    return {
        'anger': anger,
        'disgust': disgust,
        'fear': fear,
        'joy': joy,
        'sadness': sadness,
        'dominant_emotion': dominant_emotion
    }
